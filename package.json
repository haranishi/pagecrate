{
  "name": "pagecrate",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1 --port 4381",
    "build": "next build --webpack",
    "prebuild": "npm run cf-typegen",
    "start": "next start --hostname 127.0.0.1 --port 4381",
    "lint": "eslint .",
    "typecheck": "npm run cf-typegen && tsc --noEmit",
    "test": "node --import tsx --test --test-timeout=60000 --test-force-exit tests/*.test.ts",
    "test:e2e": "playwright test",
    "hygiene": "node scripts/hygiene.mjs",
    "snapshot": "node --import tsx scripts/make-public-snapshot.mjs",
    "release-gate": "node --import tsx scripts/release-gate.mjs",
    "record:day": "node --import tsx scripts/record-day-demo.mjs",
    "build:worker": "opennextjs-cloudflare build",
    "preview:worker": "opennextjs-cloudflare preview",
    "deploy": "opennextjs-cloudflare build && opennextjs-cloudflare deploy",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv --strict-vars false cloudflare-env.d.ts"
  },
  "dependencies": {
    "@cloudflare/playwright": "^1.3.6",
    "@opennextjs/cloudflare": "^1.20.12",
    "fflate": "0.8.3",
    "ipaddr.js": "2.5.0",
    "next": "16.4.2",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "engines": {
    "node": ">=24"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@playwright/test": "1.62.1",
    "@types/node": "26.6.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.2",
    "playwright": "1.62.1",
    "tsx": "4.23.13",
    "typescript": "6.0.3",
    "wrangler": "^4.156.0"
  },
  "overrides": {
    "@node-minify/core": {
      "glob": "10.5.0"
    }
  }
}
